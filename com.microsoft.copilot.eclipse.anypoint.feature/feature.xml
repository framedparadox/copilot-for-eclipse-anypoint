<?xml version="1.0" encoding="UTF-8"?>
<feature
      id="com.microsoft.copilot.eclipse.anypoint.feature"
      label="GitHub Copilot for Anypoint Studio"
      version="0.19.0.qualifier"
      provider-name="GitHub Copilot">

   <description>
      GitHub Copilot packaged with the Eclipse dependencies needed for MuleSoft Anypoint Studio.
   </description>

   <includes
         id="com.microsoft.copilot.eclipse.feature"
         version="0.0.0"/>

   <plugin
         id="com.microsoft.copilot.eclipse.anypoint"
         version="0.0.0"/>

   <requires>
      <import plugin="org.eclipse.mylyn.wikitext"/>
      <import plugin="org.eclipse.mylyn.wikitext.markdown"/>
      <import plugin="org.eclipse.mylyn.wikitext.ui"/>
      <import plugin="org.eclipse.wildwebdeveloper.embedder.node" optional="true"/>
      <import plugin="org.eclipse.jdt.debug" optional="true"/>
   </requires>

   <plugin
         id="com.microsoft.copilot.eclipse.ui.terminal.tm"
         version="0.0.0"/>

</feature>
